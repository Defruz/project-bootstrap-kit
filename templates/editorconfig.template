# Plantilla de .editorconfig — renombrar a ".editorconfig" en la raiz del repo.
# No sale de la extraccion de hipotecas (ver METHODOLOGY.md, seccion "Extras")
# - evita diffs de espacios/finales de linea entre editores sin depender de
# que cada contribuidor configure el suyo a mano.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml,json,js,ts,jsx,tsx}]
indent_size = 2

[Makefile]
indent_style = tab
