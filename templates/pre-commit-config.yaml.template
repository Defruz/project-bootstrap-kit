# Plantilla de pre-commit — ver patrón 5 de METHODOLOGY.md
#
# Regla: lo que comprueba el job `lint` de CI se comprueba aquí también,
# antes de que exista el commit. Objetivo: que CI confirme, no que descubra.
#
# Requiere: pip install pre-commit && pre-commit install
# Sustituye los hooks por los de tu stack real (los de abajo son ejemplos).

repos:
  # Ejemplo para stack Python:
  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: <VERSION>
    hooks:
      - id: ruff          # equivalente al `lint` de CI
      - id: ruff-format    # equivalente al `format check` de CI

  # Ejemplo para stack Node/TS — descomentar y adaptar si aplica:
  # - repo: local
  #   hooks:
  #     - id: eslint
  #       name: eslint
  #       entry: npx eslint .
  #       language: system
  #       pass_filenames: false
  #     - id: prettier-check
  #       name: prettier --check
  #       entry: npx prettier --check .
  #       language: system
  #       pass_filenames: false

  # Guardia genérico, útil en cualquier stack: no permitir commits directos
  # a main si tu flujo siempre pasa por rama+PR.
  - repo: local
    hooks:
      - id: no-commit-to-main
        name: Bloquear commits directos a main
        entry: bash -c '[ "$(git rev-parse --abbrev-ref HEAD)" != "main" ]'
        language: system
        pass_filenames: false
