"""Guardia contra nombres de configuracion que divergen en silencio.

Ver patron 6 de METHODOLOGY.md. Solo tiene sentido si tu configuracion cae en
un fallback silencioso cuando falta una clave (si tu app ya falla fuerte al
arrancar ante configuracion ausente/desconocida, no necesitas este script).

Compara las claves de entorno que el codigo realmente lee contra las
documentadas en tu fichero de referencia (.env.example, README, etc.) y
falla si hay claves usadas en codigo que no estan documentadas, o
documentadas que no se usan en ningun sitio (senal de que el nombre cambio
en un lado y no en el otro).

Adaptar:
- CODE_PATTERN: la forma en que tu lenguaje/stack lee env vars.
- DOCUMENTED_KEYS_SOURCE: de donde se extraen las claves "documentadas".
"""

from __future__ import annotations

import pathlib
import re
import sys

RAIZ = pathlib.Path(__file__).resolve().parent.parent

# Ejemplo para Python: os.environ["X"] / os.environ.get("X") / os.getenv("X")
CODE_PATTERN = re.compile(r'os\.(?:environ(?:\.get)?|getenv)\(\s*["\']([A-Z0-9_]+)["\']')

# Ejemplo: claves declaradas como "NOMBRE=" en un .env.example
DOC_PATTERN = re.compile(r'^([A-Z0-9_]+)=', re.MULTILINE)


def claves_usadas_en_codigo(directorio: pathlib.Path) -> set[str]:
    claves: set[str] = set()
    for archivo in directorio.rglob("*.py"):
        texto = archivo.read_text(encoding="utf-8", errors="ignore")
        claves.update(CODE_PATTERN.findall(texto))
    return claves


def claves_documentadas(archivo_env_example: pathlib.Path) -> set[str]:
    if not archivo_env_example.exists():
        return set()
    return set(DOC_PATTERN.findall(archivo_env_example.read_text(encoding="utf-8")))


def main() -> int:
    usadas = claves_usadas_en_codigo(RAIZ)
    documentadas = claves_documentadas(RAIZ / ".env.example")

    solo_en_codigo = sorted(usadas - documentadas)
    solo_en_docs = sorted(documentadas - usadas)

    if solo_en_codigo:
        print("Claves usadas en codigo pero NO documentadas en .env.example:")
        for clave in solo_en_codigo:
            print(f"  - {clave}")

    if solo_en_docs:
        print("Claves documentadas en .env.example pero que ningun codigo lee:")
        print("(puede ser un nombre viejo que ya no coincide con el codigo)")
        for clave in solo_en_docs:
            print(f"  - {clave}")

    if solo_en_codigo or solo_en_docs:
        return 1

    print(f"OK: {len(usadas)} claves de configuracion coinciden en codigo y documentacion.")
    return 0


if __name__ == "__main__":
    sys.exit(main())
